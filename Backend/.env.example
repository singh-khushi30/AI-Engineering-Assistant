# Application
APP_NAME=AI Engineering Assistant
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS (comma-separated origins; use * only for local development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# LLM / AI Foundation
# Supported providers:
#   gemini | groq | ollama | openrouter | openai | anthropic | azure_openai
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
# Optional alias for LLM_PROVIDER (takes precedence when set)
PRIMARY_PROVIDER=gemini
# Comma-separated fallback chain used on quota / timeout / rate-limit / unavailable
FALLBACK_PROVIDERS=groq,ollama
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_ON_MISSING_KEY=true

MODEL_NAME=gemini-3.5-flash
TEMPERATURE=0.2
MAX_TOKENS=1024
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=1.0

# Per-provider model overrides (used when that provider is selected / falls back)
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_MODEL=llama3.2
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENAI_MODEL=
ANTHROPIC_MODEL=
AZURE_MODEL=

# Google Gemini (default) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Free / local providers
# Groq — https://console.groq.com/keys
GROQ_API_KEY=
# Ollama — local server (no API key). Install: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
# OpenRouter free models — https://openrouter.ai/keys (prefer models ending in :free)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional paid / cloud providers (keep blank unless switching LLM_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Optional integrations
SERPER_API_KEY=

# CrewAI
CREWAI_DISABLE_TELEMETRY=true

# Review intelligence scoring (out of SCORE_MAX)
SCORE_MAX=10.0
SCORE_BASE=10.0
SCORE_WEIGHT_SECURITY=0.30
SCORE_WEIGHT_TESTING=0.25
SCORE_WEIGHT_STYLE=0.20
SCORE_WEIGHT_ARCHITECTURE=0.25
SCORE_PENALTY_CRITICAL=2.0
SCORE_PENALTY_HIGH=1.0
SCORE_PENALTY_MEDIUM=0.4
SCORE_PENALTY_LOW=0.15
SCORE_PENALTY_INFO=0.05
REPORTS_DIR=reports/output

# Tool-output summarization (compact LLM prompts)
SUMMARY_TOP_N_FINDINGS=15
SUMMARY_TOP_N_RULES=20
SUMMARY_TOP_N_FILES=20
SUMMARY_TOP_N_LOW_COVERAGE=15
SUMMARY_TOP_N_CHANGED_FILES=40
SUMMARY_CODE_SNIPPET_MAX_CHARS=180
SUMMARY_STACK_TRACE_MAX_CHARS=600
SUMMARY_LOW_COVERAGE_THRESHOLD=80
SUMMARY_STRUCTURE_TOP_LEVEL_MAX=40
SUMMARY_STRUCTURE_DIRS_MAX=40
SUMMARY_STRUCTURE_FILES_MAX=60
SUMMARY_COMPACT_JSON=true
